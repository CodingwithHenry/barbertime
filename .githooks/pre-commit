#!/usr/bin/env bash
# Run backend tests in Docker before every commit.
# Install once with: git config core.hooksPath .githooks

set -e

ROOT="$(git rev-parse --show-toplevel)"

echo "Running backend tests in Docker..."
docker compose -f "$ROOT/docker-compose.test.yml" up \
  --build \
  --abort-on-container-exit \
  --exit-code-from test \
  --quiet-pull

docker compose -f "$ROOT/docker-compose.test.yml" down -v --remove-orphans
