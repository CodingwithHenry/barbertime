# Database
DATABASE_URL=postgresql+asyncpg://barbertime:barbertime@db:5432/barbertime

# Security
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Stripe
STRIPE_SECRET_KEY=sk_test_...
